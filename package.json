{
  "name": "jarvis-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:p4-perception && npm run build:local-chat",
    "test": "node --test",
    "benchmark": "node benchmarks/benchmark.mjs",
    "benchmark:runtime": "node benchmarks/runtime-comparison.mjs",
    "evaluate:orbit": "node scripts/orbit-evaluate.mjs",
    "scout:models": "node scripts/model-scout.mjs",
    "benchmark:live": "node scripts/run-live-benchmark.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "forge:local": "node scripts/forge-local-runner.mjs",
    "forge:sandbox": "node scripts/forge-sandbox-runner.mjs",
    "build:local-chat": "esbuild hq/local-chat-engine.js --bundle --format=iife --platform=browser --target=es2022 --outfile=hq/local-chat-engine.bundle.js && node scripts/verify-local-chat-engine-bundle.mjs",
    "benchmark:p4": "npm run build && node benchmarks/p4-pipeline-benchmark.mjs",
    "build:p4-perception": "esbuild hq/p4-perception.mjs --bundle --format=esm --platform=browser --target=es2022 --outfile=hq/p4-perception.bundle.mjs && esbuild node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs --bundle --format=es --platform=browser --target=es2022 --outfile=hq/pdf.worker.bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.8.0",
    "@playwright/test": "^1.56.1",
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.87",
    "pdfjs-dist": "4.10.38"
  }
}
