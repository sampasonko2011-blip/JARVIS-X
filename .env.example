# Server only — never copy secrets into the static HQ or client bundle.
PORT=8080
JX_ALLOWED_ORIGIN=https://sampasonko2011-blip.github.io
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
JX_ATTESTATION_HMAC_KEY=GENERATE_AT_LEAST_32_RANDOM_BYTES_AND_SET_IN_HOST_SECRET_MANAGER
JX_MODEL_REGISTRY_PATH=/run/secrets/jx-model-registry.json
JX_ATTESTATIONS_PATH=/run/secrets/jx-attestations.json

