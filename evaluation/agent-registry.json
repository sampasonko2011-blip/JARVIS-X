      "status": "PROPOSED",
      "independenceGroup": "unassigned-operator",
      "allowedTools": [
        "run_sandbox_tests",
        "read_test_results",
        "inspect_diff"
      ],
      "dataAccessScope": "sandbox-test-artifacts-and-selected-diff-only",
